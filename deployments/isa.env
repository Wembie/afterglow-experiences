# Deployment profile: Isa's birthday experience.
# Everything here is PUBLIC (it ends up in the built site). No secrets.

# The address people will open. Its path becomes the build's base path.
AFTERGLOW_SITE_URL=https://wembie.github.io/mejoramigaisa

# Only Isa's experience (and its assets) is bundled into this site.
AFTERGLOW_EXPERIENCES=isa

# What link previews show. Keep personal details out unless you want them public.
AFTERGLOW_SITE_TITLE=Un universo propio
AFTERGLOW_SITE_DESCRIPTION=Cada recuerdo deja un poquito de luz.

# Where the build is published. GitHub Pages serves a repository at
# <your-pages-domain>/<repository-name>/, so this repository's name must match
# the last segment of AFTERGLOW_SITE_URL ("mejoramigaisa").
# Requires the PAGES_DEPLOY_TOKEN secret (see docs/DEPLOYMENT.md).
PAGES_TARGET_REPO=Wembie/mejoramigaisa
PAGES_TARGET_BRANCH=gh-pages
