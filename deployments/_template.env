# Copy to deployments/<name>.env (files starting with "_" are ignored).
# Everything here is PUBLIC. Never put tokens or secrets in a profile.

# Public address. Its path ("/<something>/") becomes the build's base path.
AFTERGLOW_SITE_URL=https://<your-pages-domain>/<your-path>

# Optional: override the base path explicitly (normally derived from the URL).
# AFTERGLOW_BASE_PATH=<your-path>

# Experiences to bundle (folder names in src/experiences). With exactly one,
# it opens directly at the site root.
AFTERGLOW_EXPERIENCES=<slug>
# AFTERGLOW_DEFAULT_EXPERIENCE=<slug>

AFTERGLOW_SITE_TITLE=Afterglow
AFTERGLOW_SITE_DESCRIPTION=Every memory leaves a little light behind.
# AFTERGLOW_OG_IMAGE=og-image.png
# AFTERGLOW_THEME_COLOR=#090B18

# Publishing target. Choose ONE:
#
# A) Publish to another repository named like your path (served at /<repo-name>/):
# PAGES_TARGET_REPO=<owner>/<your-path>
# PAGES_TARGET_BRANCH=gh-pages
#
# B) Publish into a folder of your user site repository (<owner>/<owner>.github.io):
# PAGES_TARGET_REPO=<owner>/<owner>.github.io
# PAGES_TARGET_BRANCH=main
# PAGES_TARGET_DIR=<your-path>
#
# C) Leave PAGES_TARGET_REPO unset to publish from this repository
#    (served at /<this-repository-name>/ unless it has its own custom domain).
