# Local build settings. Copy to .env.local (git-ignored) to try a deployment locally.
# Every value ends up in a PUBLIC static site. Never put secrets here.
# For real deployments prefer deployments/<name>.env profiles (see docs/DEPLOYMENT.md).

# Public address; its path becomes the base path (here: /mejoramigaisa/).
AFTERGLOW_SITE_URL=https://wembie.github.io/mejoramigaisa

# Or set the base path directly. Empty = relative ("./"), works under any path.
# Git Bash on Windows rewrites values starting with "/": write "mejoramigaisa".
# AFTERGLOW_BASE_PATH=mejoramigaisa

# Experiences to bundle (folders in src/experiences). One = opens at the root.
AFTERGLOW_EXPERIENCES=isa
# AFTERGLOW_DEFAULT_EXPERIENCE=isa

AFTERGLOW_SITE_TITLE=Un universo propio
AFTERGLOW_SITE_DESCRIPTION=Cada recuerdo deja un poquito de luz.
# AFTERGLOW_OG_IMAGE=og-image.png
# AFTERGLOW_THEME_COLOR=#090B18
